# Neon PostgreSQL connection string (development branch)
# https://console.neon.tech -> your project -> Connect
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Contact form (/api/contact -> Resend). Without RESEND_API_KEY the route
# returns 503 and no email is sent. https://resend.com -> API Keys
RESEND_API_KEY=
# Sender. Defaults to "Portfolio <onboarding@resend.dev>", Resend's shared
# sandbox address, which can ONLY deliver to the email the Resend account is
# registered with. Verify a domain in Resend to send from your own address.
RESEND_FROM_EMAIL=
# Inbox that receives the notifications. Defaults to semlafleur@hotmail.com,
# but while on the sandbox sender it must be the Resend account's own email.
CONTACT_TO_EMAIL=

GITHUB_TOKEN=
NEXT_PUBLIC_SITE_URL=
